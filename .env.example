# ─────────────────────────────────────────────────────────────
# GVHAX — copy to .env and fill in. Everything has a safe default,
# so the app boots with an EMPTY .env. Nothing here is required.
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# ── Database (three-tier fallback: atlas -> local -> memory) ──
# Tier 1: a hosted Atlas URI. Leave blank to skip straight to local.
MONGO_URI=
# Tier 2: local mongod. Used if MONGO_URI is blank or unreachable.
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=gvhax
# Set to "true" to force the in-memory server (useful for offline demos/tests)
MONGO_FORCE_MEMORY=false

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# ── AI provider ──────────────────────────────────────────────
# one of: anthropic | openai | gemini | ollama | mock
# Falls back to "mock" automatically if the key is missing or the call fails.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Embeddings. Anthropic does not expose an embeddings endpoint, so RAG uses
# OpenAI or Ollama when available and silently falls back to keyword scoring.
EMBED_PROVIDER=auto
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Python ML sidecar (optional) ─────────────────────────────
ML_BASE_URL=http://127.0.0.1:8000
ML_ENABLED=true

# ── Web (Vite — must be VITE_ prefixed to reach the browser) ──
VITE_API_URL=http://localhost:4000
