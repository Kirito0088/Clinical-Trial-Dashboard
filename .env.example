# ─────────────────────────────────────────────────────────────
# Clinical Trials Dashboard — copy to .env and fill in.
# Everything has a safe default, so the app boots with an
# EMPTY .env. Nothing here is required.
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# ── Database (Supabase Postgres via Prisma) ──────────────────
# Pooled connection (Transaction mode)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (for migrations)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── AI provider ──────────────────────────────────────────────
# one of: gemini | mock
# Falls back to "mock" automatically if the key is missing.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Web (Vite — must be VITE_ prefixed to reach the browser) ──
VITE_API_URL=http://localhost:4000
