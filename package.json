{
  "name": "clinical-trial-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Clinical Trials Dashboard — enrollment, adverse events, milestones, and AI insights",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:monorepo": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @ctd/api",
    "dev:web": "npm run dev -w @ctd/web",
    "build:web": "npm run build -w @ctd/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @ctd/api",
    "db:migrate": "npm run db:migrate -w @ctd/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
