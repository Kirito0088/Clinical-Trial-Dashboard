{
  "name": "gvhax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GVHAX 2026 — Computer track hackathon scaffolding (MERN + optional Python ML sidecar)",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web",
    "tools/gen"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:all": "concurrently -n api,web,ml -c cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:ml\"",
    "dev:api": "npm run dev -w @gvhax/api",
    "dev:web": "npm run dev -w @gvhax/web",
    "dev:ml": "node scripts/run-ml.mjs",
    "build": "npm run build -w @gvhax/web",
    "seed": "npm run seed -w @gvhax/api",
    "gen:feature": "node tools/gen/cli.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:ml": "node scripts/setup-ml.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
